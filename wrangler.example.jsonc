{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uploader",
	"main": "src/index.js",
	"compatibility_date": "2026-11-12",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uploader-db",
			"database_id": "YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations",
			"remote": true
		}
	]
}