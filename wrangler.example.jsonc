{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uploader",
	"main": "src/index.js",
	"compatibility_date": "2026-11-12",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simple-uploader-db",
			"database_id": "6174d103-ad45-4710-9198-eb5fce4b1d5f"
		}
	]
}
